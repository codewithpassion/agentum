{
  "name": "live-spike-local",
  "main": "worker.ts",
  "build": { "command": "bun run local-build.ts" },
  "compatibility_date": "2026-08-19",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LIVE", "class_name": "Live" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Live"] }]
}
