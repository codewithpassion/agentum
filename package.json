{
  "name": "harbourmaster",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check && turbo run typecheck && bun scripts/boundary-lint.ts",
    "clean": "bun scripts/clean.ts",
    "deploy": "turbo run deploy",
    "dev": "turbo run dev",
    "e2e:pi-durability": "bun scripts/e2e/pi-durability.ts",
    "fix": "ultracite fix",
    "prepare": "husky && turbo run cf-typegen",
    "preview": "turbo run preview",
    "tasks": "bun scripts/tasks.ts",
    "test": "turbo run test && bun test scripts"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@biomejs/biome": "2.5.6",
    "@repo/db": "workspace:*",
    "@repo/protocol": "workspace:*",
    "@repo/services": "workspace:*",
    "@types/express": "5.0.6",
    "drizzle-orm": "^0.44.7",
    "express": "5.2.1",
    "husky": "^9.1.7",
    "turbo": "^2.10.11",
    "typescript": "^5.9.2",
    "ultracite": "7.10.5"
  },
  "packageManager": "bun@1.3.11"
}
