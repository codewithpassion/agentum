{
  "name": "daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile --minify src/main.ts --outfile dist/agentum",
    "build:release": "bun build --compile --minify --target=bun-linux-x64 src/main.ts --outfile dist/agentum-linux-x64 && bun build --compile --minify --target=bun-linux-arm64 src/main.ts --outfile dist/agentum-linux-arm64",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.119",
    "@repo/db": "workspace:*",
    "@repo/library-sync": "workspace:*",
    "@repo/protocol": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  }
}
