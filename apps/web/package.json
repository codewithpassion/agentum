{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "anthropic-spike": "bun scripts/anthropic-spike.ts",
    "browser-spike": "bun scripts/browser-spike.ts",
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "computer-spike": "bun scripts/computer-spike.ts",
    "create-dev-user": "bun scripts/create-dev-user.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "bun run build && wrangler deploy",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "preview": "vite preview",
    "test": "bun test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.118.0",
    "@clerk/backend": "^3.16.8",
    "@clerk/hono": "^0.1.69",
