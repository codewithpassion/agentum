{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "agent-login": "bun scripts/agent-login.ts",
    "build": "vite build && bun scripts/check-dev-only.ts",
    "cf-typegen": "wrangler types",
    "create-dev-user": "bun scripts/create-dev-user.ts",
    "deploy": "bun run build && wrangler deploy",
    "dev": "wrangler d1 migrations apply DB --local && vite dev --port 3000",
    "e2e:log": "bun e2e/log.ts",
    "e2e:sessions": "bun e2e/sessions.ts",
    "generate-routes": "tsr generate",
    "preview": "vite preview",
    "preview:delete": "bun scripts/preview.ts delete --name",
    "preview:deploy": "bun run staging:build && bun scripts/preview.ts deploy --name",
    "staging:build": "CLOUDFLARE_ENV=staging vite build && bun scripts/check-dev-only.ts",
    "staging:deploy": "bun run staging:build && wrangler d1 migrations apply DB --remote --env staging && wrangler deploy --env staging",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/backend": "^3.16.8",
    "@clerk/hono": "^0.1.69",
    "@clerk/tanstack-react-start": "^1.4.21",
    "@cloudflare/sandbox": "1.0.1",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@hono/trpc-server": "^0.4.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@repo/db": "workspace:*",
    "@repo/mcp": "workspace:*",
    "@repo/protocol": "workspace:*",
    "@repo/services": "workspace:*",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "acorn": "^8.19.0",
    "agents": "0.28.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.44.7",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.9.10",
    "input-otp": "^1.5.0",
    "just-bash": "3.6.0",
    "lucide-react": "^1.34.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.3.27",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "latest",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "wrangler": "^4.151.0"
  }
}
