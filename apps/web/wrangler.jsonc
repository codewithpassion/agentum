{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harbourmaster",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "MACHINE_RELAY", "class_name": "MachineRelay" }]
  },
  // Migrations are not per environment, so they live at the top level only.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MachineRelay"] }],
  "routes": [
    { "pattern": "harbourmaster.rockyshoreslabs.io", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harbourmaster",
      // Filled in by `wrangler d1 create` (the setup-cloudflare skill does it).
      // Local development ignores the value.
      "database_id": "9641ef87-1cff-4136-86fc-9b0ae3f27cd6",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "env": {
    // The Worker every pull request preview hangs off (`boilerplate-staging`).
    // Previews never touch production. See README "Pull request previews".
    "staging": {
      "preview_urls": true,
      "durable_objects": {
        "bindings": [{ "name": "MACHINE_RELAY", "class_name": "MachineRelay" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "harbourmaster-staging",
          // Filled in by the setup-previews skill.
          "database_id": "local",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      // A preview inherits no bindings. Each PR gets its own D1 database:
      // apps/web/scripts/preview.ts swaps these placeholders for it after the
      // build. Never commit a real id here.
      "previews": {
        "durable_objects": {
          "bindings": [
            { "name": "MACHINE_RELAY", "class_name": "MachineRelay" }
          ]
        },
        "d1_databases": [
          {
            "binding": "DB",
            "database_name": "PREVIEW_DB_NAME_PLACEHOLDER",
            "database_id": "PREVIEW_DB_ID_PLACEHOLDER"
          }
        ]
      }
    }
  }
}
