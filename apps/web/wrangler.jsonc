{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harbourmaster",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "MACHINE_RELAY", "class_name": "MachineRelay" },
      { "name": "MANAGED_POLLER", "class_name": "ManagedPoller" },
      { "name": "PI_RUN", "class_name": "PiRun" },
      { "name": "LINUX_VM", "class_name": "VmSession" },
      { "name": "SESSION_STREAM", "class_name": "SessionStream" },
      { "name": "MAILBOX", "class_name": "MailboxDO" },
      { "name": "APP_STORE", "class_name": "AppStore" }
    ]
  },
  // The Linux VM of a cloud agent session (task C.14): a Sandbox SDK container,
  // one per session, built from container/Dockerfile. Needs the Containers
  // feature on the account and Docker on the machine that deploys.
  "containers": [
    {
      "class_name": "VmSession",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./container/Dockerfile" } }
    }
  ],
  // The sandbox for skill scripts (run_skill_script): a Dynamic Worker made for
  // each run. Needs the Workers Paid plan.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Outbound agent mail (task V5.7). `remote` stays off so local dev simulates
  // sends instead of mailing anyone.
  "send_email": [{ "name": "EMAIL" }],
  // Email Sending events (task N.4): bounces and failures of outbound agent
  // mail arrive on this queue. The queue and the subscription on the sending
  // domain are made by hand (docs/reviews/tasks/N.4.md). Production and
  // staging each have their own queue. Previews have no consumer.
  "queues": {
    "consumers": [{ "queue": "harbourmaster-mail-events" }]
  },
  // The agents' browser (task V6.11), Browser Run through @cloudflare/playwright.
  // Usage beyond the included hours is billed to the account.
  "browser": { "binding": "BROWSER" },
  // Migrations are not per environment, so they live at the top level only.
  // Never edit a tag that has shipped, add the next one.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MachineRelay"] },
    { "tag": "v2", "new_sqlite_classes": ["PiRun"] },
    { "tag": "v3", "new_sqlite_classes": ["ManagedPoller"] },
    { "tag": "v4", "new_sqlite_classes": ["VmSession"] },
    { "tag": "v5", "new_sqlite_classes": ["SessionStream"] },
    { "tag": "v6", "new_sqlite_classes": ["MailboxDO"] },
    { "tag": "v7", "new_sqlite_classes": ["AppStore"] }
  ],
  // The minute tick (src/server/tick). Crons are not per environment either:
  // only the production Worker runs them.
  "triggers": { "crons": ["* * * * *"] },
  // The public origin of the deployed app, used to build links back to it.
  // Local dev overrides it from .env.local (see .env.example).
  "vars": {
    "PUBLIC_BASE_URL": "https://harbourmaster.rockyshoreslabs.io",
    // How long a Linux VM sits idle before it snapshots /workspace and sleeps.
    "LINUX_VM_IDLE_SECONDS": "180",
    // Agent mail (task V5.7). An empty MAIL_DOMAIN turns mail off. Production
    // uses the agents. subdomain (Dom, 27 Oct 2026), with Email Routing and
    // Email Sending on for it, in the rockyshoreslabs.io zone.
    "MAIL_DOMAIN": "agents.rockyshoreslabs.io",
    "MAIL_ZONE_ID": "4dd028fe52d70f89e51383e1689d601a",
    "MAIL_WORKER_NAME": "harbourmaster",
    // Any non-empty value turns every share-link open off in this environment.
    "ARTIFACT_LINKS_OFF": ""
  },
  // Artifact link flood guards (opens, then calls and storage reads below). Counted
  // per key: the route calls them once per token and once per IP prefix. Each environment has its own namespace.
  "ratelimits": [
    {
      "name": "SHARE_OPEN_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 30, "period": 60 }
    },
    // Live link calls and storage reads: a flood guard above the service's own
    // limits (60 a minute per link, 10 per visitor), so those decide.
    {
      "name": "SHARE_CALL_LIMIT",
      "namespace_id": "2007",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "APP_API_LIMIT",
      "namespace_id": "2004",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "routes": [
    { "pattern": "harbourmaster.rockyshoreslabs.io", "custom_domain": true }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "harbourmaster-files" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harbourmaster",
      // Filled in by `wrangler d1 create` (the setup-cloudflare skill does it).
      // Local development ignores the value.
      "database_id": "9641ef87-1cff-4136-86fc-9b0ae3f27cd6",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "env": {
    // The Worker every pull request preview hangs off (`boilerplate-staging`).
    // Previews never touch production. See README "Pull request previews".
    "staging": {
      "preview_urls": true,
      // Triggers are inherited too: an empty list keeps the minute tick off
      // this Worker, as the comment on the top-level `triggers` says.
      "triggers": { "crons": [] },
      // Routes are inherited: staging must name its own, or it takes production's domain.
      "routes": [
        {
          "pattern": "harbourmaster-staging.rockyshoreslabs.io",
          "custom_domain": true
        }
      ],
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          { "name": "MACHINE_RELAY", "class_name": "MachineRelay" },
          { "name": "MANAGED_POLLER", "class_name": "ManagedPoller" },
          { "name": "PI_RUN", "class_name": "PiRun" },
          { "name": "LINUX_VM", "class_name": "VmSession" },
          { "name": "SESSION_STREAM", "class_name": "SessionStream" },
          { "name": "MAILBOX", "class_name": "MailboxDO" },
          { "name": "APP_STORE", "class_name": "AppStore" }
        ]
      },
      "containers": [
        {
          "class_name": "VmSession",
          "scheduling_policy": "durable_object",
          "images": { "base": { "dockerfile": "./container/Dockerfile" } }
        }
      ],
      "worker_loaders": [{ "binding": "LOADER" }],
      "send_email": [{ "name": "EMAIL" }],
      "queues": {
        "consumers": [{ "queue": "harbourmaster-staging-mail-events" }]
      },
      "browser": { "binding": "BROWSER" },
      "vars": {
        "PUBLIC_BASE_URL": "https://harbourmaster-staging.rockyshoreslabs.io",
        "LINUX_VM_IDLE_SECONDS": "180",
        "MAIL_DOMAIN": "rockyshoreslabs.io",
        // The zone id of rockyshoreslabs.io, from the zone's Overview page.
        // Mailboxes stay "provisioning pending" until it is set.
        "MAIL_ZONE_ID": "4dd028fe52d70f89e51383e1689d601a",
        "MAIL_WORKER_NAME": "harbourmaster-staging",
        // Any non-empty value turns every share-link open off in this environment.
        "ARTIFACT_LINKS_OFF": ""
      },
      // Artifact link flood guards (opens, then calls and storage reads). Counted per key: the route calls them
      // once per token and once per IP prefix. Each environment has its own namespace.
      "ratelimits": [
        {
          "name": "SHARE_OPEN_LIMIT",
          "namespace_id": "2002",
          "simple": { "limit": 30, "period": 60 }
        },
        // Live link calls and storage reads: a flood guard above the service's own
        // limits (60 a minute per link, 10 per visitor), so those decide.
        {
          "name": "SHARE_CALL_LIMIT",
          "namespace_id": "2008",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "APP_API_LIMIT",
          "namespace_id": "2005",
          "simple": { "limit": 300, "period": 60 }
        }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "harbourmaster-staging-files" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "harbourmaster-staging",
          // Filled in by the setup-previews skill.
          "database_id": "dadd800c-8151-4878-bb14-e25e1f345c0a",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      // A preview inherits no bindings. Each PR gets its own D1 database:
      // apps/web/scripts/preview.ts swaps these placeholders for it after the
      // build. Never commit a real id here.
      "previews": {
        "durable_objects": {
          "bindings": [
            { "name": "MACHINE_RELAY", "class_name": "MachineRelay" },
            { "name": "MANAGED_POLLER", "class_name": "ManagedPoller" },
            { "name": "PI_RUN", "class_name": "PiRun" },
            { "name": "LINUX_VM", "class_name": "VmSession" },
            { "name": "SESSION_STREAM", "class_name": "SessionStream" },
            { "name": "MAILBOX", "class_name": "MailboxDO" },
            { "name": "APP_STORE", "class_name": "AppStore" }
          ]
        },
        // Wrangler accepts no Durable Object container for previews, so a Linux
        // VM agent fails in a preview with "VmSession needs a container".
        // Isolate agents are unaffected.
        "worker_loaders": [{ "binding": "LOADER" }],
        "send_email": [{ "name": "EMAIL" }],
        "browser": { "binding": "BROWSER" },
        // No queue consumer: a queue has one consumer and staging's Worker
        // holds it. Mail is off in previews: an empty MAIL_DOMAIN.
        "vars": {
          "PUBLIC_BASE_URL": "",
          "LINUX_VM_IDLE_SECONDS": "180",
          "MAIL_DOMAIN": "",
          "MAIL_ZONE_ID": "",
          "MAIL_WORKER_NAME": "",
          // Any non-empty value turns every share-link open off in this environment.
          "ARTIFACT_LINKS_OFF": ""
        },
        // Artifact link flood guards (opens, then calls and storage reads). Counted per key: the route calls them
        // once per token and once per IP prefix. Each environment has its own namespace.
        "ratelimits": [
          {
            "name": "SHARE_OPEN_LIMIT",
            "namespace_id": "2003",
            "simple": { "limit": 30, "period": 60 }
          },
          // Live link calls and storage reads: a flood guard above the service's own
          // limits (60 a minute per link, 10 per visitor), so those decide.
          {
            "name": "SHARE_CALL_LIMIT",
            "namespace_id": "2009",
            "simple": { "limit": 120, "period": 60 }
          },
          {
            "name": "APP_API_LIMIT",
            "namespace_id": "2006",
            "simple": { "limit": 300, "period": 60 }
          }
        ],
        // Previews share the staging bucket; keys are per workspace.
        "r2_buckets": [
          { "binding": "FILES", "bucket_name": "harbourmaster-staging-files" }
        ],
        "d1_databases": [
          {
            "binding": "DB",
            "database_name": "PREVIEW_DB_NAME_PLACEHOLDER",
            "database_id": "PREVIEW_DB_ID_PLACEHOLDER"
          }
        ]
      }
    }
  }
}
