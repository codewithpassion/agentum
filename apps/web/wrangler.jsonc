{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentum-v2",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "MACHINE_RELAY", "class_name": "MachineRelay" },
      { "name": "MANAGED_POLLER", "class_name": "ManagedPoller" },
      { "name": "PI_RUN", "class_name": "PiRun" },
      { "name": "GUEST_RUN", "class_name": "GuestRun" },
      { "name": "LINUX_VM", "class_name": "VmSession" },
      { "name": "SESSION_STREAM", "class_name": "SessionStream" },
      { "name": "MAILBOX", "class_name": "MailboxDO" },
      { "name": "APP_STORE", "class_name": "AppStore" },
      { "name": "ARTIFACT_ROOM", "class_name": "ArtifactRoom" },
      {
        "name": "LIVE_ARTIFACT_MAINTENANCE",
        "class_name": "LiveArtifactMaintenance"
      }
    ]
  },
  // The Linux VM of a cloud agent session (task C.14): a Sandbox SDK container,
  // one per session, built from container/Dockerfile. Needs the Containers
  // feature on the account and Docker on the machine that deploys.
  //
  // The app name is pinned to the one the old `harbourmaster` Worker made
  // (wrangler would derive `agentum-v2-vmsession`). The VmSession namespace
  // keeps its id through the transfer (docs/v3/agentum-v2-cutover.md), and that
  // namespace is attached to this application.
  "containers": [
    {
      "name": "harbourmaster-vmsession",
      "class_name": "VmSession",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./container/Dockerfile" } }
    }
  ],
  // The sandbox for skill scripts (run_skill_script): a Dynamic Worker made for
  // each run. Needs the Workers Paid plan.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Outbound agent mail (task V5.7). `remote` stays off so local dev simulates
  // sends instead of mailing anyone.
  "send_email": [{ "name": "EMAIL" }],
  // Email Sending events (task N.4): bounces and failures of outbound agent
  // mail arrive on this queue. The queue and the subscription on the sending
  // domain are made by hand (docs/reviews/tasks/N.4.md). Production and
  // staging each have their own queue. Previews have no consumer.
  "queues": {
    "consumers": [{ "queue": "agentum-v2-mail-events" }]
  },
  // The agents' browser (task V6.11), Browser Run through @cloudflare/playwright.
  // Usage beyond the included hours is billed to the account.
  "browser": { "binding": "BROWSER" },
  // Durable Object classes, declared with `exports` (the declarative form of
  // the legacy `migrations` array, which a Worker cannot use together with it).
  // The old `harbourmaster` Worker shipped tags v1..v9 (all new_sqlite_classes).
  // `agentum-v2` starts with none: its first deploy takes the old namespaces
  // with a one-off legacy `transferred_classes` migration that
  // scripts/migrate-v2/do-transfer.ts patches into the built config, and every
  // later deploy uses this map. Never deploy this file to a Worker that has not
  // had that transfer: it would make empty namespaces under the same names.
  // Inherited by env.staging and its previews (each preview gets its own namespaces).
  "exports": {
    "MachineRelay": { "type": "durable-object", "storage": "sqlite" },
    "PiRun": { "type": "durable-object", "storage": "sqlite" },
    "ManagedPoller": { "type": "durable-object", "storage": "sqlite" },
    "VmSession": { "type": "durable-object", "storage": "sqlite" },
    "SessionStream": { "type": "durable-object", "storage": "sqlite" },
    "MailboxDO": { "type": "durable-object", "storage": "sqlite" },
    "AppStore": { "type": "durable-object", "storage": "sqlite" },
    "ArtifactRoom": { "type": "durable-object", "storage": "sqlite" },
    "LiveArtifactMaintenance": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "GuestRun": { "type": "durable-object", "storage": "sqlite" }
  },
  // The minute tick (src/server/tick). Crons are not per environment either:
  // only the production Worker runs them.
  "triggers": { "crons": ["* * * * *"] },
  // The public origin of the deployed app, used to build links back to it.
  // Local dev overrides it from .env.local (see .env.example).
  "vars": {
    "PUBLIC_BASE_URL": "https://agentumbot.io",
    // Old hostnames this Worker still answers on (comma separated). A browser
    // page load there gets a 301 to PUBLIC_BASE_URL; API calls, webhooks and
    // machine sockets are served in place (src/server/legacy-host.ts).
    "LEGACY_HOSTS": "harbourmaster.rockyshoreslabs.io",
    // How long a Linux VM sits idle before it snapshots /workspace and sleeps.
    "LINUX_VM_IDLE_SECONDS": "180",
    // Agent mail (task V5.7). An empty MAIL_DOMAIN turns mail off. Production
    // uses the agents. subdomain (Dom, 27 Oct 2026), with Email Routing and
    // Email Sending on for it, in the rockyshoreslabs.io zone.
    "MAIL_DOMAIN": "agents.rockyshoreslabs.io",
    "MAIL_ZONE_ID": "4dd028fe52d70f89e51383e1689d601a",
    "MAIL_WORKER_NAME": "agentum-v2",
    // Any non-empty value turns every share-link open off in this environment.
    "ARTIFACT_LINKS_OFF": ""
  },
  // Artifact link flood guards (opens, then calls and storage reads below). Counted
  // per key: the route calls them once per token and once per IP prefix. Each environment has its own namespace.
  "ratelimits": [
    {
      "name": "EXPORT_LIMIT",
      "namespace_id": "2012",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "SHARE_OPEN_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 30, "period": 60 }
    },
    // Live link calls and storage reads: a flood guard above the service's own
    // limits (60 a minute per link, 10 per visitor), so those decide.
    {
      "name": "SHARE_CALL_LIMIT",
      "namespace_id": "2007",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "APP_API_LIMIT",
      "namespace_id": "2004",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "routes": [
    { "pattern": "agentumbot.io", "custom_domain": true },
    // The old hostname, kept for LEGACY_HOSTS.
    { "pattern": "harbourmaster.rockyshoreslabs.io", "custom_domain": true }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "agentum-v2-files" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentum-v2",
      // Filled in from `wrangler d1 create agentum-v2` during the cutover
      // (docs/v3/agentum-v2-cutover.md). Local development ignores the value.
      // The old `harbourmaster` database is 9641ef87-1cff-4136-86fc-9b0ae3f27cd6.
      "database_id": "63fdab15-25c5-46a5-863b-e60cf04cf649",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "env": {
    // The Worker every pull request preview hangs off (`agentum-v2-staging`).
    // Previews never touch production. See README "Pull request previews".
    "staging": {
      "preview_urls": true,
      // Triggers are inherited too: an empty list keeps the minute tick off
      // this Worker, as the comment on the top-level `triggers` says.
      "triggers": { "crons": [] },
      // Routes are inherited: staging must name its own, or it takes production's domain.
      "routes": [
        { "pattern": "staging.agentumbot.io", "custom_domain": true },
        {
          "pattern": "harbourmaster-staging.rockyshoreslabs.io",
          "custom_domain": true
        }
      ],
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          { "name": "MACHINE_RELAY", "class_name": "MachineRelay" },
          { "name": "MANAGED_POLLER", "class_name": "ManagedPoller" },
          { "name": "PI_RUN", "class_name": "PiRun" },
          { "name": "GUEST_RUN", "class_name": "GuestRun" },
          { "name": "LINUX_VM", "class_name": "VmSession" },
          { "name": "SESSION_STREAM", "class_name": "SessionStream" },
          { "name": "MAILBOX", "class_name": "MailboxDO" },
          { "name": "APP_STORE", "class_name": "AppStore" },
          { "name": "ARTIFACT_ROOM", "class_name": "ArtifactRoom" },
          {
            "name": "LIVE_ARTIFACT_MAINTENANCE",
            "class_name": "LiveArtifactMaintenance"
          }
        ]
      },
      // Pinned to the old staging application, as at the top level.
      "containers": [
        {
          "name": "harbourmaster-vmsession-staging",
          "class_name": "VmSession",
          "scheduling_policy": "durable_object",
          "images": { "base": { "dockerfile": "./container/Dockerfile" } }
        }
      ],
      "worker_loaders": [{ "binding": "LOADER" }],
      "send_email": [{ "name": "EMAIL" }],
      "queues": {
        "consumers": [{ "queue": "agentum-v2-staging-mail-events" }]
      },
      "browser": { "binding": "BROWSER" },
      "vars": {
        "PUBLIC_BASE_URL": "https://staging.agentumbot.io",
        "LEGACY_HOSTS": "harbourmaster-staging.rockyshoreslabs.io",
        "LINUX_VM_IDLE_SECONDS": "180",
        "MAIL_DOMAIN": "rockyshoreslabs.io",
        // The zone id of rockyshoreslabs.io, from the zone's Overview page.
        // Mailboxes stay "provisioning pending" until it is set.
        "MAIL_ZONE_ID": "4dd028fe52d70f89e51383e1689d601a",
        "MAIL_WORKER_NAME": "agentum-v2-staging",
        // Any non-empty value turns every share-link open off in this environment.
        "ARTIFACT_LINKS_OFF": ""
      },
      // Artifact link flood guards (opens, then calls and storage reads). Counted per key: the route calls them
      // once per token and once per IP prefix. Each environment has its own namespace.
      "ratelimits": [
        {
          "name": "EXPORT_LIMIT",
          "namespace_id": "2013",
          "simple": { "limit": 6, "period": 60 }
        },
        {
          "name": "SHARE_OPEN_LIMIT",
          "namespace_id": "2002",
          "simple": { "limit": 30, "period": 60 }
        },
        // Live link calls and storage reads: a flood guard above the service's own
        // limits (60 a minute per link, 10 per visitor), so those decide.
        {
          "name": "SHARE_CALL_LIMIT",
          "namespace_id": "2008",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "APP_API_LIMIT",
          "namespace_id": "2005",
          "simple": { "limit": 300, "period": 60 }
        }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "agentum-v2-staging-files" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agentum-v2-staging",
          // Filled in from `wrangler d1 create agentum-v2-staging` during the
          // cutover. The old `harbourmaster-staging` database is
          // dadd800c-8151-4878-bb14-e25e1f345c0a.
          "database_id": "9d1ca8fc-9c6e-489a-810b-f0c37df53dfb",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      // A preview inherits no bindings. Each PR gets its own D1 database:
      // apps/web/scripts/preview.ts swaps these placeholders for it after the
      // build. Never commit a real id here.
      "previews": {
        "durable_objects": {
          "bindings": [
            { "name": "MACHINE_RELAY", "class_name": "MachineRelay" },
            { "name": "MANAGED_POLLER", "class_name": "ManagedPoller" },
            { "name": "PI_RUN", "class_name": "PiRun" },
            { "name": "GUEST_RUN", "class_name": "GuestRun" },
            { "name": "LINUX_VM", "class_name": "VmSession" },
            { "name": "SESSION_STREAM", "class_name": "SessionStream" },
            { "name": "MAILBOX", "class_name": "MailboxDO" },
            { "name": "APP_STORE", "class_name": "AppStore" },
            { "name": "ARTIFACT_ROOM", "class_name": "ArtifactRoom" },
            {
              "name": "LIVE_ARTIFACT_MAINTENANCE",
              "class_name": "LiveArtifactMaintenance"
            }
          ]
        },
        // Wrangler accepts no Durable Object container for previews, so a Linux
        // VM agent fails in a preview with "VmSession needs a container".
        // Isolate agents are unaffected.
        "worker_loaders": [{ "binding": "LOADER" }],
        "send_email": [{ "name": "EMAIL" }],
        "browser": { "binding": "BROWSER" },
        // No queue consumer: a queue has one consumer and staging's Worker
        // holds it. Mail is off in previews: an empty MAIL_DOMAIN.
        "vars": {
          "PUBLIC_BASE_URL": "",
          // In phase 1 agentumbot.io is listed here, so its page loads go to the app
          // on the old hostname, where today's Clerk instance can sign people in.
          "LEGACY_HOSTS": "harbourmaster.rockyshoreslabs.io",
          "LINUX_VM_IDLE_SECONDS": "180",
          "MAIL_DOMAIN": "",
          "MAIL_ZONE_ID": "",
          "MAIL_WORKER_NAME": "",
          // Any non-empty value turns every share-link open off in this environment.
          "ARTIFACT_LINKS_OFF": ""
        },
        // Artifact link flood guards (opens, then calls and storage reads). Counted per key: the route calls them
        // once per token and once per IP prefix. Each environment has its own namespace.
        "ratelimits": [
          {
            "name": "EXPORT_LIMIT",
            "namespace_id": "2014",
            "simple": { "limit": 6, "period": 60 }
          },
          {
            "name": "SHARE_OPEN_LIMIT",
            "namespace_id": "2003",
            "simple": { "limit": 30, "period": 60 }
          },
          // Live link calls and storage reads: a flood guard above the service's own
          // limits (60 a minute per link, 10 per visitor), so those decide.
          {
            "name": "SHARE_CALL_LIMIT",
            "namespace_id": "2009",
            "simple": { "limit": 120, "period": 60 }
          },
          {
            "name": "APP_API_LIMIT",
            "namespace_id": "2006",
            "simple": { "limit": 300, "period": 60 }
          }
        ],
        // Previews share the staging bucket; keys are per workspace.
        "r2_buckets": [
          { "binding": "FILES", "bucket_name": "agentum-v2-staging-files" }
        ],
        "d1_databases": [
          {
            "binding": "DB",
            "database_name": "PREVIEW_DB_NAME_PLACEHOLDER",
            "database_id": "PREVIEW_DB_ID_PLACEHOLDER"
          }
        ]
      }
    }
  }
}
