# Clerk
# Clerk publishable key (required) - exposed to the client via Vite
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk publishable key (required) - read by the Hono @clerk/hono middleware (same value as above)
CLERK_PUBLISHABLE_KEY=
# Clerk secret key (required)
CLERK_SECRET_KEY=

# One-click dev login (optional). When set, GET /api/dev-login signs in as
# this Clerk user via a one-time sign-in token - no Clerk UI needed. Create
# the user with `bun run create-dev-user` after setting these.
# NEVER set these in a deployed environment: their presence is what enables
# the route, so leaving them unset in production is the safety switch.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=

# Public origin of this app, used to build each agent's MCP server URL
# (`${PUBLIC_APP_URL}/mcp/<token>`). Defaults to the request origin when unset;
# set it to http://localhost:3000 locally and to the deployed URL in production.
PUBLIC_APP_URL=http://localhost:3000

# Anthropic API key for the Managed Agents integration (agent registration,
# sessions). Leave empty to run the workspace with no AI: agents stay
# `unregistered` and no session is ever created.
ANTHROPIC_API_KEY=

# AI Gateway for agents on the Cloudflare runtime (optional). When set, their
# Workers AI calls are routed through this gateway (logging, caching, rate
# limits); third-party models (openai/..., anthropic/...) always go through a
# gateway and fall back to "default" when this is unset. The Cloudflare
# runtime needs no Anthropic key at all.
AI_GATEWAY_ID=

# Set to 1 to switch the Anthropic integration off even when a key is present.
# The end-to-end suite sets it, so `bun run test:e2e` never creates real agents
# or sessions.
ANTHROPIC_DISABLED=

# Connectors (remote MCP servers). AES-GCM key for the management copies of a
# connector's OAuth tokens in D1 - base64 of 32 random bytes. Generate one with:
#   bun -e 'console.log(btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(32)))))'
# Required only to add an authenticated connector; connectors that need no auth
# work without it. Rotating the key discards the management copies (Test
# connection and the tool list ask for re-authorization); agent sessions are
# unaffected, since those run off the Anthropic vault credential.
CONNECTOR_KEY=

# The Slack bridge needs no deployment-level credentials: each connected agent
# has its own Slack app, created through the wizard in the agent's settings,
# and its bot token and signing secret are encrypted with CONNECTOR_KEY and
# stored per agent in D1.

# Cloudflare account id, used by the remote Browser Run binding during local
# development (wrangler.jsonc sets `"browser": { "remote": true }`, which proxies
# the binding to a real browser on Cloudflare's network). Needed alongside
# `wrangler login`; without it `vite dev` cannot pick an account and fails to
# start. Not needed once deployed.
CLOUDFLARE_ACCOUNT_ID=
