# Clerk
# Clerk publishable key (required) - exposed to the client via Vite
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk publishable key (required) - read by the Hono @clerk/hono middleware (same value as above)
CLERK_PUBLISHABLE_KEY=
# Clerk secret key (required)
CLERK_SECRET_KEY=

# One-click dev login (optional). When set, GET /api/dev-login signs in as
# this Clerk user via a one-time sign-in token - no Clerk UI needed. Create
# the user with `bun run create-dev-user` after setting these.
# NEVER set these in a deployed environment: their presence is what enables
# the route, so leaving them unset in production is the safety switch.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=

# Cloudflare account to deploy to (optional). Only needed when `wrangler whoami`
# lists more than one account; wrangler reads it from this file.
CLOUDFLARE_ACCOUNT_ID=

# The database is a D1 binding, not a connection string: see `d1_databases` in
# wrangler.jsonc. Nothing to set here for it.

# The public origin of this deployment. wrangler.jsonc sets the production
# value; locally it is the dev server.
PUBLIC_BASE_URL=http://localhost:3000

# Keys for encrypted connector secrets and for run tokens: 32 random bytes,
# base64 (`openssl rand -base64 32`). In production set each with
# `wrangler secret put`.
SECRETS_KEY=
RUN_TOKEN_KEY=
# Only while rotating (docs/key-rotation.md): the key each one replaced.
# Leave empty otherwise. A deployment without them works as before.
SECRETS_KEY_PREVIOUS=
RUN_TOKEN_KEY_PREVIOUS=

# HMAC key for artifact view tokens (share links): 32 random bytes, base64
# (`openssl rand -base64 32`). In production set it with
# `wrangler secret put ARTIFACT_VIEW_KEY`.
ARTIFACT_VIEW_KEY=

# Agent mail (task V5.7). The API token for Email Routing rules: Zone, Email
# Routing Rules, Edit on the mail domain's zone. Without it mailboxes stay
# "provisioning pending". MAIL_DOMAIN, MAIL_ZONE_ID and MAIL_WORKER_NAME are
# vars in wrangler.jsonc. In production set the token with
# `wrangler secret put CF_EMAIL_ROUTING_TOKEN`.
CF_EMAIL_ROUTING_TOKEN=

# GitHub skill import and update checks (task V7.12). Optional: a GitHub token
# (no scopes for public repositories) lifts the 60 requests an hour per IP
# limit on the unauthenticated GitHub API. Without it imports and the update
# check still work on public repositories. In production set it with
# `wrangler secret put GITHUB_TOKEN`.
GITHUB_TOKEN=

# One Google OAuth client for every connector on accounts.google.com (Gmail,
# Drive and the like), because Google has no dynamic client registration.
# Optional, set both or neither. A Web application client with the redirect URI
# `<app origin>/api/connectors/oauth/callback`. A client typed on a connector
# still wins. In production set each with `wrangler secret put`.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
