{
  "name": "hooks",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --target=browser --format=esm --external=cloudflare:workers --outfile=dist/index.js",
    "cf-typegen": "wrangler types --env-interface HooksEnv",
    "deploy": "wrangler deploy",
    "staging:deploy": "wrangler deploy --env staging",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/app-gateway": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/services": "workspace:*",
    "drizzle-orm": "^0.44.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "miniflare": "5.20261012.0-beta",
    "typescript": "^5.9.2",
    "wrangler": "^4.151.0"
  }
}
