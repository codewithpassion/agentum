[Unit]
Description=Agentum instance office
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
User=agentum-office-svc
ConfigurationDirectory=agentum/office
ConfigurationDirectoryMode=0700
StateDirectory=agentum/office
StateDirectoryMode=0700
ExecStart="/opt/agentum" run --instance office
Environment="HOME=/home/dom"
Environment="PATH=/home/dom/.local/bin:/home/dom/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2 3 4 5

[Install]
WantedBy=multi-user.target
